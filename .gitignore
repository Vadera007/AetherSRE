# =============================================================================
# AetherSRE — .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (contain secrets)
.env
*.env.local
*.env.production

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# Docker volumes / data
redis_data/

# Logs
*.log
logs/

# Distribution / packaging
*.tar.gz
*.whl

# Jupyter
.ipynb_checkpoints/
*.ipynb
