{
  "__inputs": [],
  "__requires": [],
  "annotations": {"list": []},
  "description": "AetherSRE Autonomous Log Anomaly & Self-Healing Engine — Real-time Observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Total Logs Ingested",
      "type": "stat",
      "targets": [{"expr": "max(aether_logs_total_persistent)", "legendFormat": "Logs", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 50}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Total Anomalies Detected",
      "type": "stat",
      "targets": [{"expr": "max(aether_anomalies_total_persistent)", "legendFormat": "Anomalies", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Vector Store Size",
      "type": "stat",
      "targets": [{"expr": "max(aether_vector_store_size)", "legendFormat": "Vectors", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "cyan", "value": null}]}}},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Total RCA Requests",
      "type": "stat",
      "targets": [{"expr": "sum(aether_rca_requests_total)", "legendFormat": "RCA Runs", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "title": "Log Ingestion Rate (per minute)",
      "type": "timeseries",
      "targets": [
        {"expr": "sum(rate(aether_logs_ingested_total[1m])) * 60", "legendFormat": "Total", "refId": "A"},
        {"expr": "sum by (service_name) (rate(aether_logs_ingested_total[1m])) * 60", "legendFormat": "{{service_name}}", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "title": "Anomaly Detection Rate",
      "type": "timeseries",
      "targets": [
        {"expr": "sum(rate(aether_anomalies_detected_total[1m])) * 60", "legendFormat": "Total Anomalies/min", "refId": "A"},
        {"expr": "sum by (service_name) (rate(aether_anomalies_detected_total[1m])) * 60", "legendFormat": "{{service_name}}", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 7,
      "title": "RCA LLM Latency",
      "type": "timeseries",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(aether_rca_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(aether_rca_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(aether_rca_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 8,
      "title": "Remediations Executed",
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (execution_type) (rate(aether_remediations_total[5m])) * 300", "legendFormat": "{{execution_type}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["aethersre", "sre", "anomaly-detection"],
  "templating": {
    "list": [{
      "current": {},
      "hide": 0,
      "includeAll": false,
      "name": "datasource",
      "options": [],
      "query": "prometheus",
      "refresh": 1,
      "type": "datasource",
      "label": "Data Source"
    }]
  },
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "AetherSRE — Autonomous SRE Engine",
  "uid": "aethersre-main",
  "version": 1
}
