# =============================================================================
# AetherSRE Environment Variables — LOCAL DEVELOPMENT
# =============================================================================
# Copy this file to .env and adjust values as needed.
# NEVER commit .env (it's in .gitignore). Commit only this .env.example.

# ── Application ───────────────────────────────────────────────────────────────
API_ENV=development
LOG_LEVEL=INFO

# ── Redis ─────────────────────────────────────────────────────────────────────
# When running via Docker Compose, set REDIS_HOST=redis (service name).
# When running the API locally (outside Docker), set REDIS_HOST=localhost.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                # Leave blank for no auth (dev only)
REDIS_MAX_CONNECTIONS=20

# ── Redis Streams ─────────────────────────────────────────────────────────────
REDIS_STREAM_NAME=telemetry_log_stream
REDIS_STREAM_MAX_LEN=100000
